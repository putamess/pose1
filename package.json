{
  "name": "pose-tool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "gen:model": "python3 scripts/gen_gltf.py",
    "gen:fixtures": "node scripts/gen_fixtures.mjs",
    "test": "npm run test:solver && npm run test:naming && npm run test:autorig && npm run test:grounding && npm run test:foreign-rig",
    "test:ui": "npm run test:smoke && npm run test:e2e && npm run test:import && npm run test:user-model && npm run test:foreign-model",
    "test:solver": "node scripts/test_solver.mjs",
    "test:naming": "node scripts/test_naming.mjs",
    "test:autorig": "node scripts/test_autorig.mjs",
    "test:grounding": "node scripts/test_grounding.mjs",
    "test:foreign-rig": "node scripts/test_foreign_rig.mjs",
    "test:foreign-model": "node scripts/test_foreign_model.mjs",
    "test:smoke": "node scripts/smoke_ui.mjs",
    "test:e2e": "node scripts/e2e_ui.mjs",
    "test:import": "node scripts/test_import.mjs",
    "test:user-model": "node scripts/test_user_model.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.63.0",
    "vite": "^5.4.11"
  }
